# Shared settings for the vLLM scripts. Override any value by exporting it
# before running a script, e.g. `MODEL=Qwen/Qwen3-8B ./scripts/serve.sh`.

# NGC vLLM image built for DGX Spark / GB10 (aarch64, sm_121, CUDA 13).
VLLM_IMAGE="${VLLM_IMAGE:-nvcr.io/nvidia/vllm:26.10-py3}"

# All model weights live here on the host; mounted into the container at /models.
MODELS_DIR="${MODELS_DIR:-$HOME/Models}"

# Hugging Face repo id; weights are stored at $MODELS_DIR/<repo id>.
MODEL="${MODEL:-Qwen/Qwen2.5-1.5B-Instruct}"

# torch.compile / CUDA graph cache, persisted so restarts skip recompilation.
CACHE_DIR="${CACHE_DIR:-$MODELS_DIR/.cache}"
# Caps parallel compile workers to soften the CPU+GPU power spike at startup.
COMPILE_THREADS="${COMPILE_THREADS:-8}"

CONTAINER_NAME="${CONTAINER_NAME:-vllm}"
PORT="${PORT:-8000}"

# --- Performance tuning for GB10 (128 GB unified LPDDR5x, 273 GB/s) ---
# Context: empty = the model's full native context window (from config.json).
# "-1" = shrink automatically to what fits in memory; a number = fixed cap.
# Max output per request is whatever the prompt leaves of this window.
MAX_MODEL_LEN="${MAX_MODEL_LEN-}"
# KV cache is sized to hold this many full-context requests at once (computed
# per model by kv_cache_size.py), instead of grabbing most of unified memory.
# 0 disables this and falls back to GPU_MEMORY_UTILIZATION.
FULL_CONTEXT_SEQS="${FULL_CONTEXT_SEQS:-4}"
# Explicit KV cache size (e.g. "16G"); overrides FULL_CONTEXT_SEQS when set.
KV_CACHE_MEMORY="${KV_CACHE_MEMORY-}"
# Fallback when the KV size can't be computed: fraction of unified memory vLLM
# may claim. The CPU/OS share the same pool, so leave headroom.
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.70}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-256}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-8192}"
# "" serves the checkpoint's native dtype (bf16). "fp8" quantizes weights on
# load; measured slower for a 1.5B model here, worth trying for 8B+ models.
QUANTIZATION="${QUANTIZATION-}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-auto}"
# balanced | interactivity (few concurrent users) | throughput (many users).
PERFORMANCE_MODE="${PERFORMANCE_MODE:-balanced}"

# Extra raw flags appended to `vllm serve`.
EXTRA_ARGS="${EXTRA_ARGS:-}"
